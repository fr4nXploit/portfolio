---
import { credentialCategories, credentialCount } from '../data/certifications';
---
<details class="credential-archive" id="certificaciones">
  <summary><span><span class="eyebrow">ARCHIVO DE FORMACIÓN</span><span class="archive-title">Ver todas las certificaciones</span></span><span class="archive-total">{credentialCount} <span aria-hidden="true">↗</span></span></summary>
  <div class="archive-body">
    <p class="archive-intro">Certificaciones, cursos y especializaciones en {credentialCategories.length} áreas. Una formación que conecta seguridad, sistemas y desarrollo.</p>
    {credentialCategories.map((category, index) => <details class="credential-category" open={index === 0}>
      <summary><span class="category-number">0{index + 1}</span><h3>{category.title}</h3><span class="category-count">{String(category.items.length).padStart(2, '0')}</span><span class="category-toggle" aria-hidden="true">+</span></summary>
      <ul class="credential-list">{category.items.map(item => <li><div><h4>{item.shortName && <><strong>{item.shortName}</strong> — </>}{item.title}</h4><p>{item.issuer}</p></div><time datetime={item.date}>{item.dateLabel}</time></li>)}</ul>
    </details>)}
  </div>
</details>
