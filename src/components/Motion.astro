<div class="reading-progress" aria-hidden="true"></div>
<div class="project-cursor" aria-hidden="true"><span>VER<br/>CASO ↗</span></div>
<button class="motion-control" type="button" aria-pressed="false" aria-label="Pausar animaciones"><span class="motion-icon" aria-hidden="true">Ⅱ</span><span class="motion-label">Pausar movimiento</span></button>

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const control = document.querySelector<HTMLButtonElement>('.motion-control');
  const hero = document.querySelector<HTMLElement>('.hero');
  const track = document.querySelector<HTMLElement>('.kinetic-track');
  const progress = document.querySelector<HTMLElement>('.reading-progress');
  const cursor = document.querySelector<HTMLElement>('.project-cursor');
  let saved: boolean | null = null;
  try {
    const preference = sessionStorage.getItem('portfolio-motion-paused');
    if (preference === 'true' || preference === 'false') saved = preference === 'true';
  } catch {}
  let paused = saved ?? reduced.matches;
  let frame = 0;

  function updateMotion() {
    root.classList.toggle('motion-paused', paused);
    control?.setAttribute('aria-pressed', String(paused));
    control?.setAttribute('aria-label', paused ? 'Activar animaciones' : 'Pausar animaciones');
    const label = control?.querySelector('.motion-label');
    const icon = control?.querySelector('.motion-icon');
    if (label) label.textContent = paused ? 'Activar movimiento' : 'Pausar movimiento';
    if (icon) icon.textContent = paused ? '▷' : 'Ⅱ';
    if (paused) {
      root.style.setProperty('--pointer-x', '0px');
      root.style.setProperty('--pointer-y', '0px');
      cursor?.classList.remove('active');
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach(el => el.style.translate = '0px 0px');
    }
    scheduleScroll();
  }

  function drawScroll() {
    frame = 0;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    if (progress) progress.style.transform = `scaleX(${total > 0 ? window.scrollY / total : 0})`;
    if (hero) {
      const distance = Math.min(window.scrollY, hero.offsetHeight);
      hero.style.setProperty('--hero-drift', paused ? '0px' : `${distance * 0.13}px`);
    }
    if (track) {
      const top = track.parentElement!.getBoundingClientRect().top;
      track.style.transform = paused ? 'none' : `translateX(${-Math.max(0, window.innerHeight - top) * 0.26}px)`;
    }
  }
  function scheduleScroll() { if (!frame) frame = requestAnimationFrame(drawScroll); }
  updateMotion();
  root.classList.add('motion-ready');
  control?.addEventListener('click', () => {
    paused = !paused;
    saved = paused;
    try { sessionStorage.setItem('portfolio-motion-paused', String(paused)); } catch {}
    updateMotion();
  });
  reduced.addEventListener('change', () => { paused = saved ?? reduced.matches; updateMotion(); });
  window.addEventListener('scroll', scheduleScroll, { passive: true });
  window.addEventListener('resize', scheduleScroll, { passive: true });

  const reveals = document.querySelectorAll<HTMLElement>('.section-heading, .career-stage, .project, .sentinels-panel, .kioscos-panel, .about-body, .community-section, .capability-intro, .capability-row, .credentials-grid, .manifesto-lines p');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  reveals.forEach(el => { el.classList.add('reveal'); observer.observe(el); });

  hero?.addEventListener('pointermove', event => {
    if (paused || !finePointer.matches) return;
    const rect = hero.getBoundingClientRect();
    root.style.setProperty('--pointer-x', `${((event.clientX - rect.left) / rect.width - .5) * 20}px`);
    root.style.setProperty('--pointer-y', `${((event.clientY - rect.top) / rect.height - .5) * 12}px`);
  });
  hero?.addEventListener('pointerleave', () => {
    root.style.setProperty('--pointer-x', '0px');
    root.style.setProperty('--pointer-y', '0px');
  });
  document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach(el => {
    el.addEventListener('pointermove', event => {
      if (paused || !finePointer.matches) return;
      const rect = el.getBoundingClientRect();
      el.style.translate = `${(event.clientX - rect.left - rect.width / 2) * .14}px ${(event.clientY - rect.top - rect.height / 2) * .14}px`;
    });
    el.addEventListener('pointerleave', () => { el.style.translate = '0px 0px'; });
  });
  document.querySelectorAll<HTMLElement>('.project-art').forEach(el => {
    el.addEventListener('pointermove', event => {
      if (paused || !finePointer.matches || !cursor) return;
      cursor.style.left = `${event.clientX}px`;
      cursor.style.top = `${event.clientY}px`;
      cursor.classList.add('active');
    });
    el.addEventListener('pointerleave', () => cursor?.classList.remove('active'));
  });
  window.addEventListener('scroll', () => cursor?.classList.remove('active'), { passive: true });
  window.addEventListener('blur', () => cursor?.classList.remove('active'));
  document.addEventListener('keydown', () => cursor?.classList.remove('active'));
</script>
